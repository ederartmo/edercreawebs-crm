# Load the project environment with scripts/start.ps1 from the external secrets file.
# Never put real values in this example. See PROJECT_SETUP.md.
# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# UUID of the CRM owner/user that should own leads created by the webhook.
CRM_OWNER_ID=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=

# Internal WhatsApp alert recipient, digits only with country code.
WHATSAPP_ADMIN_PHONE=

# Public CRM URL used in internal alerts, no trailing slash.
CRM_BASE_URL=

# Recommended for production webhook signature validation.
META_APP_SECRET=

# OpenAI
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-sol for the conversational WhatsApp sales agent.
WHATSAPP_AGENT_MODEL=
# Optional. Defaults to gpt-5.6-sol for one-shot public business-reference enrichment.
WHATSAPP_ENRICHMENT_MODEL=
# Optional. Defaults to gpt-5.6-sol for the internal proposal brief (no images/pricing).
WHATSAPP_PROPOSAL_MODEL=
# Legacy semantic-classifier override. The V2 conversational flow no longer depends on it.
WHATSAPP_CLASSIFIER_MODEL=
# Optional. Defaults to gpt-4o-mini-transcribe for WhatsApp voice notes.
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_VISION_MODEL=
OPENAI_DOCUMENT_MODEL=
